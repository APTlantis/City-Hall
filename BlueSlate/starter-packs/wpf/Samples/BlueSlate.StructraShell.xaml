<Window x:Class="Aptlantis.Sample.BlueSlate.StructraShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blue-Slate Structra Shell"
        Width="1280"
        Height="760"
        Background="{StaticResource Atl.Brush.GridBackground}"
        Foreground="{StaticResource Atl.Brush.Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Atl.Brush.BackgroundSoft}" BorderBrush="{StaticResource Atl.Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock Text="Structra" VerticalAlignment="Center" FontFamily="{StaticResource Atl.Font.Display}" FontSize="18" FontWeight="Bold" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Atl.Button.Primary}" Content="Load template" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Atl.Button.Primary}" Content="Save" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Atl.Brush.Panel}" BorderBrush="{StaticResource Atl.Brush.Border}" BorderThickness="0,0,1,0" Padding="16">
                <TextBlock Text="Structure Tree" FontWeight="Bold" />
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Atl.Brush.Panel}" BorderBrush="{StaticResource Atl.Brush.Border}" BorderThickness="0,0,1,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Field Inspector" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBox Style="{StaticResource Atl.TextBox}" Text="Site" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Atl.Brush.Background}" Padding="16">
                <TextBlock Text="Output Preview" FontWeight="Bold" />
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource Atl.Brush.BackgroundSoft}" BorderBrush="{StaticResource Atl.Brush.Border}" BorderThickness="0,1,0,0">
            <TextBlock Text="Schema valid - No issues found" Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource Atl.Brush.Verified}" />
        </Border>
    </Grid>
</Window>
