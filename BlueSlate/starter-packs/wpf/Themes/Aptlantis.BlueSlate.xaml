<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Aptlantis.BlueSlate.Colors.xaml" />
        <ResourceDictionary Source="Aptlantis.BlueSlate.Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="Atl.Font.Sans">Aptos, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Atl.Font.Display">Aptos Display, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Atl.Font.Mono">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Atl.Button.Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Atl.Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Atl.Brush.PanelRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Atl.Brush.Action}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="{StaticResource Atl.Font.Sans}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Atl.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Atl.Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Atl.Brush.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Atl.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{StaticResource Atl.Font.Sans}" />
    </Style>
</ResourceDictionary>
