  "semantic": {
    "surface": {
      "canvas": "{palette.abyss}",
      "canvas-recessed": "{palette.deep-navy}",
      "panel": "{palette.navy}",
      "panel-raised": "{palette.slate}",
      "panel-accent": "{palette.steel-blue}",
      "overlay": "{palette.deep-navy}",
      "popover": "{palette.deep-navy}",
      "input": "{palette.deep-navy}",
      "table": "{palette.deep-navy}",
      "disabled": "{palette.deep-navy}"
    },
    "content": {
      "primary": "{palette.off-white}",
      "emphasis": "{palette.off-white}",
      "secondary": "{palette.sea-foam}",
      "tertiary": "{palette.pale-mist}",
      "disabled": "{palette.cool-grey}",
      "link": "{palette.arctic-cyan}",
      "link-hover": "oklch(0.960 0.036 197.000)",
      "code": "{palette.sea-foam}",
      "code-accent": "{palette.pink}"
    },
    "structure": {
      "border": "{palette.dusk}",
      "border-soft": "{palette.blue-grey}",
      "border-strong": "{palette.cool-grey}",
      "border-translucent": "oklch(0.557827 0.030197 286.812 / 0.28)"
    },
    "intent": {
      "primary": "{palette.electric-cyan}",
      "secondary": "{palette.mist-blue}",
      "success": "{palette.success}",
      "info": "{palette.violet}",
      "warning": "{palette.amber}",
      "danger": "{palette.danger}",
      "attention": "{palette.brass}",
      "taxonomy": "{palette.violet}",
      "archive": "{palette.indigo}",
      "verified": "{palette.verified}"
    },
    "interaction": {
      "action": "{palette.electric-cyan}",
      "action-secondary": "{palette.teal}",
      "hover": "{palette.arctic-cyan}",
      "active": "{palette.steel-blue}",
      "disabled": "{palette.cool-grey}",
      "focus": "{palette.arctic-cyan}"
    },
    "validation": {
      "valid": "{palette.verified}",
      "valid-border": "{palette.success}",
      "invalid": "{palette.danger}",
      "invalid-border": "{palette.danger}"
    }
  },
  "component": {
    "panel": {
      "background": "{semantic.surface.panel}",
      "raised-background": "{semantic.surface.panel-raised}",
      "border": "{semantic.structure.border}"
    },
    "button": {
      "primary-background": "{semantic.intent.primary}",
      "secondary-background": "{semantic.interaction.action-secondary}",
      "danger-background": "{semantic.intent.danger}",
      "foreground": "{semantic.surface.canvas}",
      "focus": "{semantic.interaction.focus}",
      "disabled": "{semantic.interaction.disabled}"
    },
    "input": {
      "background": "{semantic.surface.input}",
      "foreground": "{semantic.content.primary}",
      "border": "{semantic.structure.border}",
      "valid": "{semantic.validation.valid-border}",
      "invalid": "{semantic.validation.invalid-border}"
    },
    "tab": {
      "background": "{semantic.surface.canvas-recessed}",
      "active": "{semantic.interaction.active}",
      "foreground": "{semantic.content.secondary}"
    },
    "table": {
      "background": "{semantic.surface.table}",
      "header": "{semantic.surface.panel}",
      "border": "{semantic.structure.border-soft}"
    },
    "code": {
      "background": "{semantic.surface.canvas}",
      "foreground": "{semantic.content.code}",
      "keyword": "{semantic.intent.primary}",
      "string": "{semantic.intent.verified}",
      "number": "{semantic.intent.attention}"
    },
    "chip": {
      "neutral": "{semantic.content.secondary}",
      "active": "{semantic.intent.primary}",
      "verified": "{semantic.intent.verified}",
      "warning": "{semantic.intent.warning}",
      "taxonomy": "{semantic.intent.taxonomy}",
      "archive": "{semantic.intent.archive}"
    },
    "alert": {
      "info": "{semantic.intent.info}",
      "success": "{semantic.intent.success}",
      "warning": "{semantic.intent.warning}",
      "danger": "{semantic.intent.danger}"
    }
  },
  "foundation": {
    "radius": {
      "small": "0.375rem",
      "default": "0.625rem",
      "large": "0.875rem",
      "extra-large": "1.25rem",
      "pill": "50rem"
    },
    "spacing": {
      "zero": "0",
      "one": "0.25rem",
      "two": "0.5rem",
      "three": "1rem",
      "four": "1.5rem",
      "five": "3rem"
    },
    "elevation": {
      "small": "0 0.125rem 0.5rem oklch(0 0 0 / 0.22)",
      "panel": "0 0.5rem 1.5rem oklch(0 0 0 / 0.30), inset 0 1px 0 oklch(0.920072 0.015742 120.888 / 0.05)",
      "floating": "0 1.25rem 4.375rem oklch(0 0 0 / 0.38), inset 0 1px 0 oklch(0.920072 0.015742 120.888 / 0.07)",
      "inset": "inset 0 1px 2px oklch(0 0 0 / 0.30)"
    },
    "focus-ring": {
      "width": "0.25rem",
      "opacity": 0.3,
      "color": "{semantic.interaction.focus}"
    }
  },
  "typography": {
    "display": "\"Aptos Display\", \"Segoe UI Variable Display\", \"Segoe UI\", system-ui, sans-serif",
    "sans": "\"Aptos\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif",
    "mono": "\"Cascadia Code\", \"Cascadia Mono\", \"JetBrains Mono\", \"SFMono-Regular\", Consolas, monospace"
  }
}
